{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Taste Signal",
  "type": "object",
  "required": [
    "id",
    "object",
    "category",
    "attraction",
    "user_meaning",
    "source_ids",
    "confirmation",
    "visibility"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "object": {
      "type": "string"
    },
    "category": {
      "enum": [
        "FILM",
        "ANIMATION",
        "BOOK",
        "MUSIC",
        "GAME",
        "PERSON",
        "CHARACTER",
        "ART",
        "BRAND",
        "PLACE",
        "ARCHITECTURE",
        "OBJECT",
        "FOOD",
        "OTHER"
      ]
    },
    "attraction": {
      "type": "string"
    },
    "user_meaning": {
      "type": "string"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proposed_motif": {
      "type": [
        "string",
        "null"
      ]
    },
    "recurrence": {
      "type": "integer",
      "minimum": 1
    },
    "counter_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "confirmation": {
      "enum": [
        "AI_PROPOSED",
        "USER_CONFIRMED",
        "USER_EDITED",
        "USER_REJECTED"
      ]
    },
    "visibility": {
      "enum": [
        "PRIVATE",
        "CONTEXT_ONLY",
        "PUBLIC_CANDIDATE",
        "PUBLIC_CONFIRMED"
      ]
    }
  }
}
