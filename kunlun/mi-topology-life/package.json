{
  "name": "kunlun-mi-topology-life",
  "version": "0.1.0",
  "private": true,
  "description": "《弥：拓扑生命》— Kunlun Protocol experimental short. Procedural, deterministic, frame-driven 3D animation.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "preview": "remotion studio src/index.ts",
    "lint": "eslint src tests scripts",
    "typecheck": "tsc --noEmit",
    "build": "remotion bundle src/index.ts --out-dir build && vite build --config vite.debugger.config.ts",
    "test": "vitest run",
    "render:test": "remotion render src/index.ts C001-RenderTest out/c001-render-test.mp4",
    "verify:video": "node scripts/verify-video.mjs out/c001-render-test.mp4 --width 1920 --height 1080 --fps 30 --frames 90 --duration 3",
    "verify:determinism": "node scripts/verify-determinism.mjs",
    "verify:preview": "node scripts/verify-preview.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "debug": "vite --config vite.debugger.config.ts",
    "test:log": "node scripts/test-log.mjs",
    "verify:debugger": "node scripts/verify-debugger.mjs",
    "evidence:c002": "node scripts/collect-evidence.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "render:film:preview": "node scripts/film-render.mjs video --out renders/mi-preview-540p.mp4 --scale 0.5 --tag render-preview-540p",
    "render:film:master": "node scripts/film-render.mjs video --out renders/mi-visual-master-1080p.mp4 --tag render-master-1080p",
    "verify:film": "node scripts/verify-film.mjs",
    "verify:film:video": "node scripts/verify-video.mjs renders/mi-visual-master-1080p.mp4 --width 1920 --height 1080 --fps 30 --frames 900 --duration 30 --no-audio && node scripts/verify-video.mjs renders/mi-preview-540p.mp4 --width 960 --height 540 --fps 30 --frames 900 --duration 30 --no-audio",
    "render:contact-sheet": "node scripts/contact-sheet.mjs",
    "acceptance:c003": "bash scripts/acceptance-c003.sh"
  },
  "dependencies": {
    "@react-three/fiber": "9.7.0",
    "@remotion/cli": "4.0.525",
    "@remotion/three": "4.0.525",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.525",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@remotion/eslint-config-flat": "4.0.525",
    "@remotion/renderer": "4.0.525",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/three": "0.186.0",
    "eslint": "9.39.4",
    "globals": "16.4.0",
    "playwright": "1.56.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
