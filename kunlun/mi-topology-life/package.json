{
  "name": "kunlun-mi-topology-life",
  "version": "0.1.0",
  "private": true,
  "description": "《弥：拓扑生命》— Kunlun Protocol experimental short. Procedural, deterministic, frame-driven 3D animation.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "preview": "remotion studio src/index.ts",
    "lint": "eslint src tests scripts",
    "typecheck": "tsc --noEmit",
    "build": "remotion bundle src/index.ts --out-dir build",
    "test": "vitest run",
    "render:test": "remotion render src/index.ts C001-RenderTest out/c001-render-test.mp4",
    "verify:video": "node scripts/verify-video.mjs out/c001-render-test.mp4 --width 1920 --height 1080 --fps 30 --frames 90 --duration 3",
    "verify:determinism": "node scripts/verify-determinism.mjs",
    "verify:preview": "node scripts/verify-preview.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@react-three/fiber": "9.7.0",
    "@remotion/cli": "4.0.525",
    "@remotion/three": "4.0.525",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.525",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@remotion/eslint-config-flat": "4.0.525",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/three": "0.186.0",
    "eslint": "9.39.4",
    "globals": "16.4.0",
    "playwright": "1.56.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
